# WordPress Plugin .gitignore

# WordPress core files
wp-config.php
wp-content/uploads/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/cache/
wp-content/cache/supercache/

# WordPress debugging and error logs
debug.log
error_log
*.log

# Temporary files
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js dependencies (if using build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build directories
dist/
build/

# Composer dependencies (if using)
vendor/
composer.lock

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Package managers
package-lock.json
yarn.lock

# Backup files
*.bak
*.backup
*.old

# Archive files
*.zip
*.tar.gz
*.rar

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows specific
Desktop.ini

# Plugin specific exclusions
# Exclude any local development or test files
local-config.php
test-config.php
dev-notes.txt

# Exclude any generated documentation that shouldn't be versioned
docs/generated/

# Exclude any local development databases
*.sqlite
*.db

# Exclude any local SSL certificates
*.pem
*.key
*.crt

# Exclude any local cache files
cache/
*.cache
