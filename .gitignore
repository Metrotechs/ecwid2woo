# WordPress Plugin .gitignore for Production Release

# Development and build files
node_modules/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# WordPress core files (shouldn't be in plugin anyway)
wp-config.php
wp-content/uploads/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/cache/
wp-content/cache/supercache/

# Logs and debugging
debug.log
error_log
*.log
php_errors.log

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.old
*~

# Build and compilation
dist/
build/
*.min.js.map
*.min.css.map

# Package managers
vendor/
composer.lock
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and config files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
local-config.php
test-config.php

# Development notes and documentation
dev-notes.txt
docs/generated/
TODO.md
DEVELOPMENT.md

# Database files
*.sqlite
*.db

# SSL certificates
*.pem
*.key
*.crt

# Cache files
cache/
*.cache

# Archive files that shouldn't be versioned
*.zip
*.tar.gz
*.rar

# System files
.Spotlight-V100
.Trashes
ehthumbs.db
._*

# Plugin development specific
/tests/
/phpunit.xml
/phpcs.xml
/.github/
/webpack.config.js
/gulpfile.js
/Gruntfile.js

# Version control
.git/
.gitmodules

# IDE project files
*.sublime-project
*.sublime-workspace
*.code-workspace
